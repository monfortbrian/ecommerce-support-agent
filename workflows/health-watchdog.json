    {
      "parameters": {
        "jsCode": "\nconst s = $input.first().json;\nconst cfg = s.cfg;\nconst last = s.last_intake_success_iso ? new Date(s.last_intake_success_iso).getTime() : NaN;\nif (isNaN(last)) {\n  return [{ json: { test_mode: s.test_mode, exceeded: false, planned_action: 'No last success checkpoint stored. Downtime check skipped.' } }];\n}\nconst threshold = Number(cfg.downtime_recovery_threshold_minutes || 45);\nconst minutes = Math.round((Date.now() - last) / 60000);\nconst exceeded = minutes > threshold;\nreturn [{ json: { test_mode: s.test_mode, exceeded, minutes_since_success: minutes, threshold_minutes: threshold,\n  cutoff_override: new Date(last).toISOString(),\n  planned_action: exceeded ? 'Backfill the mailbox from ' + new Date(last).toISOString() + ' through the intake workflow' : 'Intake is healthy.' } }];"
      },
