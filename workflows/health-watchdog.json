      "name": "IF: Test Mode",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $input.first().json.cfg;\nconst now = Date.now();\nconst ago = (min) => new Date(now - min * 60000).toISOString();\nconst base = { status: 'pending_approval', ruleset_version: 1, retry_count: 0, last_error: '',\n  slack_ts: '1700000000.000100', sharepoint_uploaded: true, checkpoint: ago(2), opened_at: ago(20) };\nconst cases = [\n  { ...base, case_id: 'CS-DEMO-0001', slack_ts: '' },\n  { ...base, case_id: 'CS-DEMO-0002', sharepoint_uploaded: false },\n  { ...base, case_id: 'CS-DEMO-0003', status: 'processing', slack_ts: '', checkpoint: ago(120), retry_count: 1, last_error: 'Azure OpenAI 429 rate limit during classification' },\n  { ...base, case_id: 'CS-DEMO-0004', opened_at: ago(60 * 30) },\n  { ...base, case_id: 'CS-DEMO-0005', ruleset_version: 0 },\n  { ...base, case_id: 'CS-DEMO-0006' },\n  { ...base, case_id: 'CS-DEMO-0007', status: 'processing', slack_ts: '', checkpoint: ago(240), retry_count: 3, last_error: 'classification parse failure' }\n];\nreturn [{ json: { cfg, test_mode: true, cases, junk_count: 2, last_intake_success_iso: ago(95) } }];"
      },
