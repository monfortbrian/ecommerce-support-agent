    {
      "parameters": {
        "jsCode": "\nconst flagged = $('Code: Flag Stuck and Stale Cases').all().map(i => i.json);\nconst by = {};\nfor (const f of flagged) by[f.reason] = (by[f.reason] || 0) + 1;\nreturn [{ json: {\n  mode: flagged.length && flagged[0].test_mode ? 'demo, mock data' : 'live data',\n  flagged_count: flagged.length, by_reason: by,\n  actions: flagged.map(f => ({ case_id: f.case_id, reason: f.reason, action: f.planned_action })) } }];"
      },
      "id": "bf97dbfe-59b4-4f98-89c7-798113daf88b",
      "name": "Code: Build Run Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst s = $input.first().json;\nconst n = s.junk_count || 0;\nreturn [{ json: { test_mode: s.test_mode, slack_channel: s.cfg.slack_channel, junk_count: n,\n  planned_action: n > 0 ? 'Post a low priority review request for ' + n + ' junk folder message(s). Never auto-process them.' : 'Junk folder is empty.' } }];"
      },
      "id": "3aa761d5-70a2-4d68-ac48-56f2b05cfc6e",
      "name": "Code: Junk Folder Check",
