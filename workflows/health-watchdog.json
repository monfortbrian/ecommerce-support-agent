    {
      "parameters": {
        "jsCode": "\nconst run = $('Code: Resolve Run Parameters').first().json;\nconst cases = $('Data Table: Get Cases').all().map(i => i.json).filter(r => r && r.case_id);\nconst junk = $input.first().json.value || [];\nreturn [{ json: { cfg: run.cfg, test_mode: false, cases, junk_count: junk.length,\n  last_intake_success_iso: run.cfg.last_intake_success_iso || '' } }];"
      },
      "id": "b93eb546-19ae-4da5-94ac-dbe5c9004466",
      "name": "Code: Build Live State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst s = $input.first().json;\nconst cfg = s.cfg;\nconst now = Date.now();\nconst minutes = (iso) => (now - new Date(iso).getTime()) / 60000;\nconst stuckMin = Number(cfg.stuck_checkpoint_minutes || 30);\nconst slaMin = Number(cfg.sla_hours || 24) * 60;\nconst maxRetries = Number(cfg.max_retries || 3);\nconst cfgVersion = parseInt(cfg.config_version, 10);\nconst ORDER = ['ai_failed', 'missing_slack', 'missing_sharepoint', 'stale_ruleset', 'sla_breach'];\nconst ACTION = {\n  ai_failed: 'Retry classification through the intake workflow',\n  missing_slack: 'Re-post the case card to Slack',\n  missing_sharepoint: 'Re-upload the evidence file to SharePoint',\n  stale_ruleset: 'Reprocess the case with the current ruleset',\n  sla_breach: 'Escalate to the ops channel'\n};\nconst out = [];\nfor (const c of s.cases) {\n  if (['approved', 'parked', 'forwarded', 'closed'].includes(c.status)) continue;\n  const open = c.status === 'pending_approval';\n  const stuck = c.status === 'processing' && minutes(c.checkpoint) > stuckMin;\n  const hits = [];\n  if (stuck && /azure|openai|classif/i.test(c.last_error || '')) hits.push('ai_failed');\n  if (!c.slack_ts && (stuck || open)) hits.push('missing_slack');\n  if (c.sharepoint_uploaded === false) hits.push('missing_sharepoint');\n  if (open && Number(c.ruleset_version) < cfgVersion) hits.push('stale_ruleset');\n  if (open && c.opened_at && minutes(c.opened_at) > slaMin) hits.push('sla_breach');\n  if (!hits.length) continue;\n  let reason = ORDER.find(r => hits.includes(r));\n  let escalation_cause = null;\n  if (Number(c.retry_count || 0) >= maxRetries && reason !== 'sla_breach') {\n    reason = 'sla_breach';\n    escalation_cause = 'retries_exhausted';\n  }\n  out.push({ json: { case_id: c.case_id, reason, all_reasons: hits, retry_count: Number(c.retry_count || 0),\n    escalation_cause, planned_action: ACTION[reason] + (escalation_cause ? ' (retries exhausted)' : ''),\n    test_mode: s.test_mode, slack_channel: cfg.slack_channel, ops_channel: cfg.ops_channel, sp_site_id: cfg.sp_site_id } });\n}\nreturn out;"
      },
